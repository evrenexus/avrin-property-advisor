name: Update Avrin Listings

on:
  workflow_dispatch:
  schedule:
    - cron: "0 */6 * * *"

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      # ---------------------------------------------------------
      # 1. Checkout
      # ---------------------------------------------------------
      - name: Checkout
        uses: actions/checkout@v4

      # ---------------------------------------------------------
      # 2. Node.js
      # ---------------------------------------------------------
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      # ---------------------------------------------------------
      # 3. Install Playwright
      # ---------------------------------------------------------
      - name: Install Playwright
        run: |
          npm init -y
          npm install playwright
          npx playwright install --with-deps chromium

      # ---------------------------------------------------------
      # 4. Collect Divar cards through Apify
      # ---------------------------------------------------------
      - name: Collect Divar listings
        env:
          APIFY_TOKEN: ${{ secrets.APIFY_TOKEN }}
        run: |
          set -e

          mkdir -p data
          rm -f data/raw-*.json
          rm -f data/part-*.json

          echo "========================================"
          echo "Starting Avrin Divar collection"
          echo "========================================"

          cities=("tehran" "mashhad" "tabriz")
          types=("sale" "rent")
          queries=("فروش" "اجاره")

          index=0

          for CITY in "${cities[@]}"; do
            for TYPE_INDEX in 0 1; do

              TYPE="${types[$TYPE_INDEX]}"
              QUERY="${queries[$TYPE_INDEX]}"

              echo ""
              echo "----------------------------------------"
              echo "City: $CITY"
              echo "Type: $TYPE"
              echo "Query: $QUERY"
              echo "----------------------------------------"

              RESPONSE=$(curl -sS --fail-with-body \
                -X POST \
                "https://api.apify.com/v2/acts/hipersoft~divar-scraper/runs" \
                -H "Authorization: Bearer ${APIFY_TOKEN}" \
                -H "Content-Type: application/json" \
                -d "{
                  \"city\": \"${CITY}\",
                  \"query\": \"${QUERY}\",
                  \"category\": \"real-estate\",
                  \"maxItems\": 50
                }")

              RUN_ID=$(echo "$RESPONSE" | jq -r '.data.id')
              DATASET_ID=$(echo "$RESPONSE" | jq -r '.data.defaultDatasetId')

              if [ "$RUN_ID" = "null" ] || [ -z "$RUN_ID" ]; then
                echo "Could not start Apify run."
                echo "$RESPONSE"
                exit 1
              fi

              echo "Run ID: $RUN_ID"

              STATUS=""

              for i in {1..60}; do

                RESPONSE_STATUS=$(curl -sS \
                  "https://api.apify.com/v2/actor-runs/${RUN_ID}" \
                  -H "Authorization: Bearer ${APIFY_TOKEN}")

                STATUS=$(echo "$RESPONSE_STATUS" | jq -r '.data.status')

                echo "Attempt $i - Status: $STATUS"

                if [ "$STATUS" = "SUCCEEDED" ]; then
                  break
                fi

                if [ "$STATUS" = "FAILED" ] || \
                   [ "$STATUS" = "ABORTED" ] || \
                   [ "$STATUS" = "TIMED-OUT" ]; then

                  echo "Apify run failed."
                  echo "$RESPONSE_STATUS"
                  exit 1
                fi

                sleep 10
              done

              if [ "$STATUS" != "SUCCEEDED" ]; then
                echo "Apify scraper did not finish in time."
                exit 1
              fi

              curl -sS --fail-with-body \
                "https://api.apify.com/v2/datasets/${DATASET_ID}/items?format=json&clean=true" \
                -H "Authorization: Bearer ${APIFY_TOKEN}" \
                -o "data/raw-${index}.json"

              jq \
                --arg dealType "$TYPE" \
                --arg cityCode "$CITY" \
                'map(. + {
                  dealType: $dealType,
                  sourceCity: $cityCode,
                  source: "divar"
                })' \
                "data/raw-${index}.json" \
                > "data/part-${index}.json"

              rm "data/raw-${index}.json"

              index=$((index + 1))

            done
          done

          jq -s 'add' data/part-*.json > data/raw-listings.json

          echo ""
          echo "Raw listings:"
          jq 'length' data/raw-listings.json

          rm -f data/part-*.json

      # ---------------------------------------------------------
      # 5. Create detail-page scraper
      # ---------------------------------------------------------
      - name: Create detail scraper
        run: |
          cat > scrape-details.js <<'EOF'
          const fs = require("fs");
          const { chromium } = require("playwright");

          const input = JSON.parse(
            fs.readFileSync("data/raw-listings.json", "utf8")
          );

          const MAX_AGE_HOURS = 6;

          const sleep = ms =>
            new Promise(resolve => setTimeout(resolve, ms));

          function normalizeText(value) {
            if (!value) return "";

            return value
              .replace(/\u200c/g, " ")
              .replace(/\s+/g, " ")
              .trim();
          }

          function faToEn(value) {
            if (!value) return "";

            const fa = "۰۱۲۳۴۵۶۷۸۹";
            const ar = "٠١٢٣٤٥٦٧٨٩";

            return String(value)
              .replace(/[۰-۹]/g, d => fa.indexOf(d))
              .replace(/[٠-٩]/g, d => ar.indexOf(d));
          }

          function numberFrom(value) {
            if (!value) return null;

            const n = faToEn(value)
              .replace(/,/g, "")
              .replace(/٬/g, "")
              .match(/\d+(?:\.\d+)?/);

            return n ? Number(n[0]) : null;
          }

          function extractArea(text) {
            const patterns = [
              /(?:متراژ|زیربنا|مساحت)\s*[:\-]?\s*([۰-۹0-9]{2,5})\s*متر/,
              /([۰-۹0-9]{2,5})\s*متر\s*(?:مربع)?/
            ];

            for (const p of patterns) {
              const m = text.match(p);
              if (m) return numberFrom(m[1]);
            }

            return null;
          }

          function extractRooms(text) {
            const patterns = [
              /(\d+)\s*خواب/,
              /(\d+)\s*خوابه/,
              /(\d+)\s*اتاق/
            ];

            for (const p of patterns) {
              const m = text.match(p);

              if (m) {
                return numberFrom(m[1]);
              }
            }

            return null;
          }

          function extractYear(text) {
            const patterns = [
              /(?:سال ساخت|ساخت)\s*[:\-]?\s*(13\d{2})/,
              /(?:سال ساخت|ساخت)\s*[:\-]?\s*(14\d{2})/,
              /(?:سال ساخت|ساخت)\s*[:\-]?\s*(\d{4})/
            ];

            for (const p of patterns) {
              const m = faToEn(text).match(p);

              if (m) {
                return numberFrom(m[1]);
              }
            }

            return null;
          }

          function extractFloor(text) {
            const patterns = [
              /(?:طبقه)\s*[:\-]?\s*(\d+)/,
              /طبقه\s+(\d+)/,
              /(\d+)\s*ام\s*طبقه/
            ];

            for (const p of patterns) {
              const m = faToEn(text).match(p);

              if (m) {
                return numberFrom(m[1]);
              }
            }

            return null;
          }

          function extractUnits(text) {
            const patterns = [
              /(?:تعداد واحد|تعداد واحدها|واحد)\s*[:\-]?\s*(\d+)/,
              /(\d+)\s*واحدی/,
              /(\d+)\s*واحد/
            ];

            for (const p of patterns) {
              const m = faToEn(text).match(p);

              if (m) {
                return numberFrom(m[1]);
              }
            }

            return null;
          }

          function extractUsage(text) {

            const t = normalizeText(text);

            if (
              /اداری|دفتر کار|دفتراداری/.test(t)
            ) {
              return "اداری";
            }

            if (
              /تجاری|مغازه|فروشگاه|واحد تجاری/.test(t)
            ) {
              return "تجاری";
            }

            if (
              /زمین|کلنگی/.test(t)
            ) {
              return "زمین";
            }

            if (
              /ویلایی|ویلا/.test(t)
            ) {
              return "ویلایی";
            }

            return "مسکونی";
          }

          function extractParking(text) {
            if (/پارکینگ\s*ندارد|بدون\s*پارکینگ/.test(text)) {
              return false;
            }

            if (/پارکینگ/.test(text)) {
              return true;
            }

            return null;
          }

          function extractElevator(text) {
            if (/آسانسور\s*ندارد|بدون\s*آسانسور/.test(text)) {
              return false;
            }

            if (/آسانسور/.test(text)) {
              return true;
            }

            return null;
          }

          function extractStorage(text) {
            if (/انباری\s*ندارد|بدون\s*انباری/.test(text)) {
              return false;
            }

            if (/انباری/.test(text)) {
              return true;
            }

            return null;
          }

          function sellerType(text) {

            const t = normalizeText(text);

            const agencyPatterns = [
              "مشاور املاک",
              "مشاورین املاک",
              "املاک",
              "آژانس",
              "دفتر فروش",
              "دپارتمان املاک",
              "هلدینگ",
              "بنگاه",
              "گروه املاک",
              "مجموعه املاک",
              "دفتر املاک"
            ];

            for (const word of agencyPatterns) {
              if (t.includes(word)) {
                return "agency";
              }
            }

            const personalPatterns = [
              "مالک",
              "شخصی",
              "فروشنده شخصی",
              "مستقیم از مالک"
            ];

            for (const word of personalPatterns) {
              if (t.includes(word)) {
                return "personal";
              }
            }

            return "unknown";
          }

          function extractTimeText(text) {

            const patterns = [
              /لحظاتی پیش/,
              /دقایقی پیش/,
              /(\d+)\s*دقیقه پیش/,
              /(\d+)\s*ساعت پیش/,
              /امروز/,
              /دیروز/
            ];

            for (const p of patterns) {
              const m = text.match(p);

              if (m) {
                return normalizeText(m[0]);
              }
            }

            return "";
          }

          function ageHoursFromTime(timeText) {

            if (!timeText) return null;

            const t = faToEn(timeText);

            if (/لحظاتی پیش/.test(t)) {
              return 0;
            }

            if (/دقایقی پیش/.test(t)) {
              return 0.25;
            }

            let m = t.match(/(\d+)\s*دقیقه پیش/);

            if (m) {
              return Number(m[1]) / 60;
            }

            m = t.match(/(\d+)\s*ساعت پیش/);

            if (m) {
              return Number(m[1]);
            }

            if (/امروز/.test(t)) {
              return 12;
            }

            if (/دیروز/.test(t)) {
              return 36;
            }

            return null;
          }

          async function extractStructuredData(page) {

            return await page.evaluate(() => {

              const result = {
                jsonLd: [],
                nextData: null
              };

              document
                .querySelectorAll('script[type="application/ld+json"]')
                .forEach(script => {
                  try {
                    result.jsonLd.push(
                      JSON.parse(script.textContent)
                    );
                  } catch {}
                });

              const next = document.querySelector(
                'script#__NEXT_DATA__'
              );

              if (next) {
                try {
                  result.nextData = JSON.parse(
                    next.textContent
                  );
                } catch {}
              }

              return result;
            });
          }

          async function scrapeOne(browser, item, index) {

            const page = await browser.newPage({
              viewport: {
                width: 1440,
                height: 1000
              },
              locale: "fa-IR"
            });

            page.setDefaultTimeout(30000);

            try {

              console.log(
                `[${index + 1}/${input.length}] ${item.token}`
              );

              await page.goto(item.url, {
                waitUntil: "domcontentloaded",
                timeout: 30000
              });

              await page.waitForTimeout(2500);

              const data = await page.evaluate(() => {

                const body = document.body;

                const allText = body
                  ? body.innerText
                  : "";

                const title =
                  document.querySelector("h1")?.innerText ||
                  document.title ||
                  "";

                const images = [
                  ...document.querySelectorAll("img")
                ]
                  .map(img =>
                    img.currentSrc ||
                    img.src ||
                    img.getAttribute("data-src") ||
                    img.getAttribute("data-original")
                  )
                  .filter(Boolean)
                  .filter(src =>
                    src.includes("divarcdn.com") ||
                    src.includes("divar.ir")
                  );

                const descriptionCandidates = [
                  '[data-testid="description"]',
                  '[class*="description"]',
                  '[class*="Description"]'
                ];

                let description = "";

                for (const selector of descriptionCandidates) {

                  const elements =
                    document.querySelectorAll(selector);

                  for (const element of elements) {

                    const txt =
                      element.innerText?.trim();

                    if (txt && txt.length > description.length) {
                      description = txt;
                    }
                  }
                }

                return {
                  title: title.trim(),
                  bodyText: allText.trim(),
                  description: description.trim(),
                  images: [...new Set(images)]
                };
              });

              const structured =
                await extractStructuredData(page);

              const text =
                normalizeText(
                  `${data.bodyText} ${data.title}`
                );

              const timeText =
                extractTimeText(text);

              const ageHours =
                ageHoursFromTime(timeText);

              const seller =
                sellerType(
                  `${text} ${item.subtitle || ""}`
                );

              if (
                seller !== "personal"
              ) {
                console.log(
                  `SKIP seller=${seller} token=${item.token}`
                );

                await page.close();

                return null;
              }

              if (
                ageHours !== null &&
                ageHours > MAX_AGE_HOURS
              ) {
                console.log(
                  `SKIP old listing ${ageHours}h`
                );

                await page.close();

                return null;
              }

              const description =
                data.description ||
                data.bodyText;

              const images = [
                ...new Set([
                  ...(item.images || []),
                  ...(data.images || [])
                ])
              ];

              const result = {

                token: item.token,

                title:
                  data.title ||
                  item.title,

                description:

                  description
                    .replace(
                      data.title || item.title || "",
                      ""
                    )
                    .trim(),

                price:
                  item.price ?? null,

                priceText:
                  item.priceText || "",

                currency:
                  item.currency || "IRT",

                dealType:
                  item.dealType,

                city:
                  item.city ||
                  "",

                district:
                  item.district ||
                  "",

                area:
                  extractArea(text),

                rooms:
                  extractRooms(text),

                buildYear:
                  extractYear(text),

                floor:
                  extractFloor(text),

                units:
                  extractUnits(text),

                usage:
                  extractUsage(text),

                parking:
                  extractParking(text),

                elevator:
                  extractElevator(text),

                storage:
                  extractStorage(text),

                sellerType:
                  "personal",

                sellerText:
                  item.subtitle || "",

                listingTime:
                  timeText,

                ageHours:
                  ageHours,

                images:
                  images,

                imageCount:
                  images.length,

                url:
                  item.url,

                source:
                  "divar",

                sourceCity:
                  item.sourceCity,

                scrapedAt:
                  new Date().toISOString(),

                structuredData:
                  structured
              };

              await page.close();

              return result;

            } catch (error) {

              console.log(
                `ERROR ${item.token}: ${error.message}`
              );

              await page.close();

              return null;
            }
          }

          (async () => {

            const browser = await chromium.launch({
              headless: true
            });

            const results = [];

            for (
              let i = 0;
              i < input.length;
              i++
            ) {

              const result =
                await scrapeOne(
                  browser,
                  input[i],
                  i
                );

              if (result) {
                results.push(result);
              }

              await sleep(700);
            }

            await browser.close();

            const unique = new Map();

            for (const item of results) {

              if (!item.token) continue;

              unique.set(
                item.token,
                item
              );
            }

            const finalData =
              Array.from(unique.values());

            fs.writeFileSync(
              "data/listings.json",
              JSON.stringify(
                finalData,
                null,
                2
              ),
              "utf8"
            );

            console.log("");
            console.log(
              "========================================"
            );
            console.log(
              `FINAL PERSONAL LISTINGS: ${finalData.length}`
            );
            console.log(
              "========================================"
            );

          })();
          EOF

      # ---------------------------------------------------------
      # 6. Run detail scraper
      # ---------------------------------------------------------
      - name: Scrape listing details
        run: |
          node scrape-details.js

      # ---------------------------------------------------------
      # 7. Validate final JSON
      # ---------------------------------------------------------
      - name: Validate listings
        run: |
          set -e

          test -f data/listings.json

          jq empty data/listings.json

          echo ""
          echo "========================================"
          echo "FINAL RESULTS"
          echo "========================================"

          echo "Total:"
          jq 'length' data/listings.json

          echo "Sale:"
          jq '[.[] | select(.dealType == "sale")] | length' \
            data/listings.json

          echo "Rent:"
          jq '[.[] | select(.dealType == "rent")] | length' \
            data/listings.json

          echo "Personal:"
          jq '[.[] | select(.sellerType == "personal")] | length' \
            data/listings.json

          echo "With description:"
          jq '[.[] | select(.description != null and .description != "")] | length' \
            data/listings.json

          echo "With images:"
          jq '[.[] | select(.images | length > 0)] | length' \
            data/listings.json

          echo "========================================"

      # ---------------------------------------------------------
      # 8. Show sample
      # ---------------------------------------------------------
      - name: Show sample
        run: |
          jq '.[0:3]' data/listings.json

      # ---------------------------------------------------------
      # 9. Commit
      # ---------------------------------------------------------
      - name: Commit listings
        run: |
          set -e

          git config user.name "Avrin Bot"
          git config user.email "avrin-bot@users.noreply.github.com"

          git add data/listings.json

          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "Update Avrin listings"
            git push
          fi
